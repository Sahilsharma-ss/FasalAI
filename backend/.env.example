# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://your-backend-name.onrender.com

# Database Connection (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fasalai?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# OpenRouter AI API Key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allowed Frontend Origins (CORS) - Set to your Vercel URL
CLIENT_ORIGIN=https://your-app-name.vercel.app

# GitHub OAuth Credentials (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
